# Application
APP_BASE_URL=http://localhost:3000

# Google / Gmail OAuth
# https://console.cloud.google.com/  → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Microsoft / Outlook OAuth (Azure AD app registration)
# https://portal.azure.com/  → App registrations → New registration
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Local DB path
DATABASE_PATH=./data/dashboard.sqlite
